OPENAI_API_KEY=
OPENAI_PLANNING_MODEL=gpt-5.6-terra
OPENAI_COMPLEX_MODEL=gpt-5.6-sol
OPENAI_TEXT_MODEL=gpt-5.4-mini
OPENAI_IMAGE_MODEL=gpt-image-2
# medium balances preview detail and latency; low, high and auto are also supported.
OPENAI_IMAGE_QUALITY=medium
# Per model attempt (30000-240000 ms); all image attempts share a 360000 ms budget.
OPENAI_IMAGE_TIMEOUT_MS=180000
PORT=3011
# PKCS#8 PEM. Required in production so every instance can decrypt the same submissions.
# Generate with: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
DATA_ENCRYPTION_PRIVATE_KEY=
# Comma-separated browser origins, for example https://your-site.netlify.app
ALLOWED_ORIGINS=

# Optional Resend email delivery. Use a verified sender domain. Never expose these in VITE_* variables.
RESEND_API_KEY=
EMAIL_FROM=
